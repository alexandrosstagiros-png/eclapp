# Copy to /etc/ecl/migration.env, owned by root:root with mode 0600.
# Used only for backups, schema migrations and initial production bootstrap.
NODE_ENV=production

# Schema owner with the rights described in docs/VK_CLOUD_DEPLOYMENT.md.
# Enable ssl=on in VK Cloud database parameters before using this TLS URL.
# URL-encode the administrator password; use the hostname covered by DB TLS.
MIGRATION_DATABASE_URL=postgresql://transport_admin:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@DB_PRIVATE_HOST:5432/transport?sslmode=verify-full

# Raw (not URL-encoded) password, at least 20 characters, matching app.env.
APP_DB_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_APPLICATION_PASSWORD

# If VK Cloud supplies a private CA, configure both Node and PostgreSQL client:
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/vk-postgresql-ca.pem
# PGSSLROOTCERT=/etc/ssl/certs/vk-postgresql-ca.pem
