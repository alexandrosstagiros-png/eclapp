# Copy to /etc/ecl/app.env, owned by root:root with mode 0600.
# Replace every REPLACE/DB_PRIVATE_HOST value before starting the service.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_LOOPBACK=true

# Restricted runtime role only. URL-encode the actual password.
# Match the raw password to APP_DB_PASSWORD in migration.env.
# For VK Cloud, create transport_app in the instance Users tab with this password.
# Enable ssl=on in VK Cloud database parameters before using this TLS URL.
# Use the database hostname covered by its TLS certificate.
DATABASE_URL=postgresql://transport_app:REPLACE_WITH_URL_ENCODED_PASSWORD@DB_PRIVATE_HOST:5432/transport?sslmode=verify-full
# Obtain the trusted CA and correct certificate hostname from VK Cloud if needed.
# If using a private CA, install its public certificate and uncomment:
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/vk-postgresql-ca.pem

# Replace the example IP with your HTTPS public IP or domain, with no trailing slash.
ALLOWED_ORIGINS=https://203.0.113.10
SESSION_TTL_SECONDS=1800
DEV_AUTH_ENABLED=false
DEMO_AUTH_ENABLED=false
DEMO_EMPLOYEE_CREATION_ENABLED=false
LOCAL_ONE_C_ENABLED=false
ONE_C_HTTP_ENABLED=false

# Persistent private storage outside releases; bootstrap.sh creates this path.
ONBOARDING_PHOTO_DIR=/var/lib/ecl/onboarding-photos

# Enable integrations separately after configuring their secrets and callbacks.
MAX_NOTIFICATIONS_ENABLED=false
TELEGRAM_COMMUNICATIONS_ENABLED=false
TELEGRAM_ONBOARDING_ENABLED=false

# Optional carrier requisites lookup. Keep the actual key in this server file only.
# DADATA_API_KEY=

# Optional neural providers. Set only the keys you use, then restart the API.
# Models and per-task prices are configured in «Нейросети → Модели и задачи».
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# ZHIPU_API_KEY=
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
